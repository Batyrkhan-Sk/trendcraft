# Copy to .env and fill in what you have. Everything is optional — with no keys
# at all the platform still runs end to end on the seeded corpus using local
# deterministic implementations.
#
# Values shown are the defaults from backend/app/core/config.py. Under Docker
# these are also mirrored in docker-compose.yml; a variable that is not passed
# through there will appear to do nothing when you edit it here.

# --- AI (Gemini) -------------------------------------------------------------
# One key covers generation, video understanding and embeddings.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

LLM_MODEL=gemini-3.6-flash         # trend narration, scenarios, recording guides
LLM_FAST_MODEL=gemini-3.5-flash    # cheap high-volume passes
VISION_MODEL=gemini-3.6-flash      # native video understanding
EMBEDDING_PROVIDER=gemini          # gemini | local
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768                  # must match the DB; changing it needs a --reset

# Videos analysed concurrently. Native video analysis is ~30s of mostly waiting
# on Gemini, so this is the biggest lever on pipeline throughput. Raise it until
# you start seeing 429s from your tier.
ANALYSIS_CONCURRENCY=6

# --- Data collection ---------------------------------------------------------
# YouTube Data API v3. Falls back to GOOGLE_API_KEY if unset.
YOUTUBE_API_KEY=

# TikTok and Instagram have no public discovery API. Apify is the supported
# path — setting APIFY_TOKEN alone is enough to enable both connectors.
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=                # default: clockworks~tiktok-scraper
APIFY_INSTAGRAM_ACTOR=             # default: apify~instagram-reel-scraper

# Optional JSON override for the built-in per-niche Instagram seed accounts,
# e.g. {"ai": ["aiadvantage"], "fitness": ["jeffnippard"]}. Invalid JSON is
# ignored with a warning and the defaults are used.
INSTAGRAM_SEED_ACCOUNTS=

# Alternative to Apify: point these at any other dataset provider (Bright Data,
# Ensemble, …) — see backend/app/connectors/social.py for the expected request
# and response shape. Ignored unless set.
TIKTOK_PROVIDER_URL=
TIKTOK_PROVIDER_TOKEN=
INSTAGRAM_PROVIDER_URL=
INSTAGRAM_PROVIDER_TOKEN=

# --- Deployment (production only; ignored locally) ---------------------------
# Hostname Caddy will obtain a TLS certificate for. Must already resolve to the
# server's public IP before first boot, or issuance fails.
DOMAIN=

# Generate both:  openssl rand -base64 32
POSTGRES_PASSWORD=
# Shared secret for POST /api/v1/pipeline/* — those routes spend Gemini quota,
# YouTube quota and Apify credit. REQUIRED on any public deployment.
PIPELINE_TOKEN=

# --- Trend engine tuning -----------------------------------------------------
MIN_CLUSTER_SIZE=4
CLUSTER_SIMILARITY_THRESHOLD=0.62
TREND_HALF_LIFE_HOURS=96

# --- Infrastructure ----------------------------------------------------------
# Defaults target a local (non-Docker) run. docker-compose.yml overrides both to
# point at the postgres/redis service names instead.
DATABASE_URL=postgresql+psycopg://trendcraft:trendcraft@localhost:5432/trendcraft
REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=development

# Origins allowed to call the API from a browser. Must match the port the web
# app is actually served on — client-side Save/Generate/Recreate calls are
# cross-origin and get blocked otherwise.
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010","http://localhost:3000"]
